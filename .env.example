# Pinto Chat Desktop — environment variables
# Copy to .env and adjust. The old VITE_PINTO_* names are still read.

# API base URL (no trailing slash)
PINTO_API_BASE_URL=https://api-dev.pinto-app.com

# WebSocket base for chat realtime (optional, derived from the API URL)
PINTO_WS_URL=wss://api-dev.pinto-app.com

# WebSocket for QR login (optional, derived from the API URL)
# Dev: ws://localhost:8080/ws/auth/qr
# Prod: wss://api.pinto-app.com/ws/auth/qr
PINTO_QR_AUTH_WS_URL=
