# Pinto Chat Desktop — Environment Variables
# Copy this file to .env and update values for your environment.

# API base URL (no trailing slash)
VITE_PINTO_API_BASE_URL=https://api-dev.pinto-app.com

# WebSocket base URL for chat realtime
VITE_PINTO_WS_URL=wss://api-dev.pinto-app.com

# WebSocket URL for QR login (optional — derived from API base URL if empty)
# Dev: ws://localhost:8080/ws/auth/qr
# Prod: wss://api.pinto-app.com/ws/auth/qr
VITE_PINTO_QR_AUTH_WS_URL=
