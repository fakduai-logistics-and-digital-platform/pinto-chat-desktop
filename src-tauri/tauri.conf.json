{
  "$schema": "https://raw.githubusercontent.com/nickelpack/tauri-v2-schemas/refs/heads/main/json-schema/2.1.1/tauri.schema.json",
  "productName": "Pinto Chat Desktop",
  "version": "0.1.0",
  "identifier": "com.pinto.chat-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pinto Chat Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "sql": {
      "scope": {
        "all": true
      }
    }
  }
}
